{
  "name": "@youldali/result-flow",
  "version": "1.0.0",
  "description": "Lazy, typed workflow composition for neverthrow Result and ResultAsync values.",
  "keywords": [
    "neverthrow",
    "result",
    "resultasync",
    "typescript",
    "functional",
    "workflow",
    "retry",
    "polling"
  ],
  "license": "ISC",
  "author": "Yannis Ouldali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youldali/result-flow.git"
  },
  "bugs": {
    "url": "https://github.com/youldali/result-flow/issues"
  },
  "homepage": "https://github.com/youldali/result-flow#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "packageManager": "npm@11.13.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "node --import tsx --test src/*.test.ts",
    "test:only": "node --import tsx --test-only src/result-flow.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "neverthrow": "^8.2.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "neverthrow": "^8.2.0"
  },
  "volta": {
    "node": "25.2.1"
  }
}
